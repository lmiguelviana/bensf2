{
  "name": "bensf2",
  "version": "1.0.0",
  "description": "BenSF2 - Live Sampler Workstation and Live MIDI Keyboard Synth (Electron, Mobile & VST3)",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "web": "npx http-server -p 8080 .",
    "pack:dir": "electron-builder --dir",
    "dist": "electron-builder",
    "build:vst3": "cmake -B vst3/build -S vst3 && cmake --build vst3/build --config Release"
  },
  "keywords": [
    "bensf2",
    "soundfont",
    "sf2",
    "midi",
    "web-audio",
    "electron",
    "workstation",
    "sampler",
    "synth",
    "vst3"
  ],
  "author": "Developer",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.bensf2.app",
    "productName": "BenSF2 Workstation",
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**/*",
      "css/**/*",
      "js/**/*",
      "index.html",
      "main.js",
      "preload.js",
      "manifest.json",
      "sw.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
